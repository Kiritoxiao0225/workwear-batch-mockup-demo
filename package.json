{
  "name": "workwear-batch-mockup-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "catalog:manifest": "tsx scripts/catalog.ts manifest",
    "catalog:migrate": "tsx scripts/catalog.ts migrate",
    "catalog:import": "tsx scripts/catalog.ts import",
    "catalog:verify": "tsx scripts/catalog.ts verify",
    "catalog:user": "tsx scripts/catalog.ts create-user",
    "catalog:dev": "tsx scripts/catalog-dev.ts",
    "catalog:dev:local": "tsx scripts/catalog-local.ts",
    "local": "CATALOG_LOCAL_AUTH=1 CATALOG_LOCAL_PORT=3001 tsx scripts/catalog-local.ts",
    "catalog:backup": "tsx scripts/catalog.ts backup",
    "catalog:restore": "tsx scripts/catalog.ts restore",
    "test:catalog": "tsx scripts/catalog-integration.ts",
    "test:auth": "tsx scripts/auth-integration.ts",
    "test:intake": "tsx --test batch-mockup/tests/intake.test.mjs",
    "test:saas": "tsx scripts/saas-runtime-integration.mjs",
    "test:production-storage": "tsx scripts/production-storage-integration.ts",
    "production:dev": "node scripts/start-production-local.mjs",
    "artwork:worker": "tsx scripts/artwork-worker.ts",
    "test:artwork-jobs": "tsx scripts/artwork-jobs-integration.ts",
    "test:shared-artwork": "tsx scripts/shared-artwork-integration.ts",
    "test:reliability": "tsx scripts/production-reliability-integration.ts",
    "production:migrate-cutout": "tsx scripts/migrate-cutout-images.ts",
    "batch:dev": "tsx batch-mockup/scripts/local.ts",
    "test:batch": "vitest run --config batch-mockup/vitest.config.ts",
    "build:batch": "cd batch-mockup && next build --webpack",
    "test:a": "node --test batch-mockup/experiments/standardize-36/*.test.mjs",
    "test:b": "tsx --test batch-mockup/tests/b-*.test.mjs",
    "test:workbench": "tsx --test batch-mockup/tests/workbench.test.mjs",
    "test:requirements": "tsx --test batch-mockup/tests/requirements.test.mjs batch-mockup/tests/requirements-editor.test.mjs batch-mockup/tests/production.test.mjs batch-mockup/tests/evolink-production.test.mjs batch-mockup/tests/production-repair.test.mjs batch-mockup/tests/production-edit.test.mjs batch-mockup/tests/automatic-flow.test.mjs batch-mockup/tests/wps-sync.test.mjs",
    "requirements:dev": "tsx batch-mockup/experiments/workbench/requirements-server.mjs",
    "test:mockups": "tsx --test batch-mockup/tests/mockups.test.mjs batch-mockup/tests/mockup-save.test.mjs",
    "test:batch-claim": "tsx scripts/batch-claim-integration.mjs",
    "test:batch-cloud": "tsx batch-mockup/tests/cloud-integration.mjs",
    "garment:worker": "tsx scripts/garment-worker.ts",
    "test:garment": "tsx scripts/garment-mockup-integration.ts",
    "garment:styles": "tailwindcss -c scripts/garment-tailwind.config.cjs -i components/garment-editor/utilities.source.css -o components/garment-editor/utilities.css --minify",
    "garment:worker:local": "tsx scripts/garment-worker.ts --local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@better-auth/utils": "0.5.0",
    "@napi-rs/canvas": "1.0.9",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@uiw/color-convert": "2.10.3",
    "@uiw/react-color": "2.10.3",
    "ali-oss": "^6.23.0",
    "fabric": "7.4.0",
    "fast-xml-parser": "5.11.1",
    "jszip": "3.10.1",
    "lucide-react": "1.16.0",
    "meitu-cli": "2.1.21",
    "motion": "12.40.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-image-crop": "11.0.10",
    "sharp": "0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
