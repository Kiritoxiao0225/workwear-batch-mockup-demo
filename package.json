{
  "name": "mockfits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "catalog:migrate": "tsx scripts/catalog.ts migrate",
    "catalog:user": "tsx scripts/catalog.ts create-user",
    "catalog:dev": "tsx scripts/catalog-dev.ts",
    "catalog:dev:local": "NODE_USE_ENV_PROXY=1 tsx scripts/catalog-local.ts",
    "local": "NODE_USE_ENV_PROXY=1 CATALOG_LOCAL_AUTH=1 CATALOG_LOCAL_PORT=3001 tsx scripts/catalog-local.ts",
    "catalog:backup": "tsx scripts/catalog.ts backup",
    "catalog:restore": "tsx scripts/catalog.ts restore",
    "test:auth": "tsx scripts/auth-integration.ts",
    "test:intake": "tsx --test batch-mockup/tests/intake.test.mjs",
    "production:dev": "node scripts/start-production-local.mjs",
    "artwork:worker": "tsx scripts/artwork-worker.ts",
    "test:requirements": "tsx --test batch-mockup/tests/production.test.mjs batch-mockup/tests/production-output.test.mjs batch-mockup/tests/evolink-production.test.mjs batch-mockup/tests/production-edit.test.mjs batch-mockup/tests/automatic-flow.test.mjs batch-mockup/tests/wps-sync.test.mjs batch-mockup/tests/requirements-editor.test.mjs batch-mockup/tests/mockup-save.test.mjs batch-mockup/tests/workbench-snapshot.test.mjs",
    "test:batch-claim": "tsx scripts/batch-claim-integration.mjs",
    "test:batch-cloud": "tsx batch-mockup/tests/cloud-integration.mjs",
    "test:listing": "node --import ./scripts/no-network.mjs --import tsx scripts/listing-images-integration.ts",
    "listing:worker:local": "NODE_USE_ENV_PROXY=1 tsx scripts/listing-worker.ts --local",
    "ops:preflight": "node scripts/ops/production-preflight.mjs",
    "test:stability": "vitest run lib/server/catalog-offsite-backup.test.ts lib/server/catalog-backup-scheduler.test.ts && node --test batch-mockup/tests/resource-guard.test.mjs scripts/ops/production-preflight.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@better-auth/utils": "0.5.0",
    "@napi-rs/canvas": "1.0.9",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "ali-oss": "^6.23.0",
    "fabric": "7.4.0",
    "fast-xml-parser": "5.11.1",
    "jszip": "3.10.1",
    "meitu-cli": "2.1.21",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-image-crop": "11.0.10",
    "sharp": "0.35.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
