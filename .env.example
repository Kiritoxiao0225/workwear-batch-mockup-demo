# Server-only Ark credential. Never expose this value to the browser.
ARK_RUNTIME_API_KEY=

# Optional model overrides. Defaults match the tested Logo Studio route.
VISION_MODEL_EP=doubao-seed-2-0-lite-260215
# Optional override for apron placement recognition; defaults to VISION_MODEL_EP.
CATALOG_PLACEMENT_MODEL=
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828

# WPS B redraw / C styled text / D whole artwork image provider.
# cliproxy: gpt-image-2, requests 2048x2048 Medium PNG; ark: existing Seedream 5.0 Lite 2K.
# The proxy may return a different size. Processing details record actual decoded dimensions.
# Explicit switch only; there is no automatic fallback or retry on generation failure.
ARTWORK_IMAGE_PROVIDER=ark
CLIPROXY_API_BASE_URL=
CLIPROXY_API_KEY=

# WPS requirement analysis only; uses the same server-only proxy credentials above.
# cliproxy: GPT-5.6 Sol, text + image input, medium reasoning, JSON output.
# ark: existing VISION_MODEL_EP. Failures do not automatically switch providers.
WPS_ANALYSIS_PROVIDER=ark
WPS_ANALYSIS_MODEL=gpt-5.6-sol
# 需求解析低推理强度减少延迟；Luna max 本次真实样本超时，GPT-6 可用但未更快。
WPS_ANALYSIS_REASONING_EFFORT=low

# AI MediaKit uses its own API Key. Ark API Keys are not interchangeable.
# Used by task-review image quality evaluation, enhancement and background removal.
MEDIAKIT_API_KEY=

# WPS 抠图：使用美图海外官方 CLI 2.1.21 的 image-cutout（model_type=2）。
# 凭据仅服务端读取；不使用国内旧 REST 抠图地址或前端环境变量。
MEITU_OPENAPI_ACCESS_KEY=
MEITU_OPENAPI_SECRET_KEY=
# 本地文件模式可选；云模式先由数据库管理员执行 007_artwork_cutout_jobs.sql。
ARTWORK_CUTOUT_CACHE_DIR=

# 原表脚本接入（仅服务端），无需 WPS 应用 ID/密钥；安装步骤 /wps-connect。
WPS_CONNECTION_MODE=airscript
WPS_AIRSCRIPT_WEBHOOK=
WPS_AIRSCRIPT_TOKEN=
WPS_DBSHEET_SHEET_NAME=效果图任务管理
WPS_SOURCE_URL=https://365.kdocs.cn/view/l/cj5Qvp0WVtjz
# 可选：旧数字文件 ID。当前 365 Webhook 使用原表链接标识 cj5Qvp0WVtjz。
WPS_DBSHEET_FILE_ID=
# 多个状态列时，脚本顶部 STATUS_FIELD_NAME 与此项填写相同实际列名。
WPS_STATUS_FIELD_NAME=
# 以下旧 OAuth 配置仅在 WPS_CONNECTION_MODE=oauth 时使用。
# 此客户应用尚未通过真实表访问验证，请勿当作已接通。
# 用户授权：kso.dbsheet.read、kso.dbsheet.readwrite、kso.file.read、kso.file_link.readwrite。
# 分享链接中的 /l/... 是 link_id；服务端解析 file_id 并校验可选的文件 ID。
WPS_APP_ID=
WPS_APP_KEY=
WPS_DBSHEET_SHEET_ID=1
# 必须与 WPS 开放平台「安全配置 → 用户授权回调配置」完全一致。
WPS_OAUTH_REDIRECT_URI=http://localhost:3001/api/wps/oauth/callback

# 商品素材库：独立 PostgreSQL schema garment_catalog。凭据仅服务端使用。
CATALOG_DATABASE_URL=
# 云库使用独立应用账号；管理连接只供 migrate / restore 命令使用。
CATALOG_DATABASE_MIGRATION_URL=
# 私有 CA 的 PEM 内容（支持带 \n 的单行值）；同时校验证书和数据库主机身份。
CATALOG_DATABASE_CA_CERT=
CATALOG_OSS_BUCKET=
CATALOG_OSS_REGION=
CATALOG_OSS_ACCESS_KEY_ID=
CATALOG_OSS_ACCESS_KEY_SECRET=
CATALOG_OSS_PREFIX=workwear-mockup/prod
# 部署在反向代理后时填写浏览器访问的准确 origin，例如 https://example.com。
CATALOG_APP_ORIGIN=
# 免密码共享工作台：所有访问者使用此现有账号；写操作仍校验来源和角色。
CATALOG_AUTH_MODE=open
# 仅服务端使用，必须是 users 中未停用的真实账号。
CATALOG_LOGIN_EMAIL=
# 仅本地开发可显式使用；生产环境会拒绝本地对象存储，不会静默降级。
CATALOG_LOCAL_OBJECT_ROOT=

# 迁移完成后启用。生产状态在 PostgreSQL，图片在同一私有 OSS。
WPS_PRODUCTION_STORAGE=cloud
WPS_PRODUCTION_STATE_KEY=main
# 保存成功后删除无引用旧图；仅服务端使用，部署 Vercel 时同样配置。
# 复用已授权的新制作目录删除账号，不授予商品原图删除权限。
PRODUCTION_DELETE_ACCESS_KEY_ID=
PRODUCTION_DELETE_ACCESS_KEY_SECRET=

# 完成 010 迁移并启动独立 artwork:worker 后，Web 与后台同时设为 1。
# 关闭开关只停用新网页入口，不删除已提交任务；退出旧后台前应先排空。
ARTWORK_DURABLE_JOBS=0

# 完成 012 迁移、部署新 Web/worker，再同时开启；失败解析仅显式重试。
# 开启后 worker 每 30 秒发现待领取/设计中的新需求，关闭浏览器也继续解析并保存。
WPS_DURABLE_ANALYSIS=0
# 新 Web/worker 均支持读取文件引用后设为 oss；默认 inline 供滚动升级过渡。
# 历史回执迁移：npm run production:migrate-cutout -- --apply --limit=10
ARTWORK_CUTOUT_FILE_STORAGE=inline

# Set zeabur only after both Web and worker support mixed OSS/Zeabur file records.
CATALOG_IMAGE_STORAGE=oss
CATALOG_IMAGE_STORE_URL=
CATALOG_IMAGE_STORE_TOKEN=
CATALOG_IMAGE_STORE_SIGNING_KEY=
CATALOG_IMAGE_STORE_DELETE_TOKEN=
