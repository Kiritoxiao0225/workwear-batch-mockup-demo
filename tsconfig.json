{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-catalog-build/types/**/*.ts",
    ".next-catalog-build/dev/types/**/*.ts",
    ".next-catalog/types/**/*.ts",
    ".next-catalog/dev/types/**/*.ts",
    ".next-port3000/types/**/*.ts",
    ".next-port3000/dev/types/**/*.ts",
    ".next-production-cloud/types/**/*.ts",
    ".next-production-cloud/dev/types/**/*.ts",
    ".next-latency-verify/types/**/*.ts",
    ".next-latency-verify/dev/types/**/*.ts",
    ".next-workwear-3001/types/**/*.ts",
    ".next-workwear-3001/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".tmp",
    "output"
  ]
}
